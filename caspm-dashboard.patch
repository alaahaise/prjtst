diff --git a/public/css/theme.css b/public/css/theme.css
index faed76d..ee08349 100644
--- a/public/css/theme.css
+++ b/public/css/theme.css
@@ -540,3 +540,45 @@ button:only-child > svg.icon:only-child{ margin-right:0; }
 button svg.icon{ margin-right:.4em; }
 button svg.icon:only-child{ margin-right:0; }
 
+
+/* ============================================================
+   Dashboard — KPI cards, chart panels
+   ============================================================ */
+.dash-head{ display:flex; align-items:flex-end; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-bottom:18px; }
+.dash-head h1{ margin:0; font-size:22px; font-weight:800; letter-spacing:-.4px; }
+.dash-sub{ margin-top:3px; font-size:12px; color:var(--text-soft); text-transform:capitalize; }
+.dash-controls{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
+.dash-controls input[type=month]{ padding:6px 10px; }
+.dash-loading{ opacity:.55; pointer-events:none; transition:opacity .15s; }
+
+.dash-kpis{ display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:14px; margin-bottom:18px; }
+.kpi{
+  background:var(--card); border:1px solid var(--border); border-radius:var(--radius);
+  padding:16px 18px; box-shadow:var(--shadow); display:flex; flex-direction:column; gap:8px; min-width:0;
+}
+.kpi-top{ display:flex; align-items:center; justify-content:space-between; gap:8px; }
+.kpi-label{ font-size:10px; font-weight:700; letter-spacing:.8px; color:var(--text-faint); text-transform:uppercase; }
+.kpi-icon{
+  width:30px; height:30px; border-radius:9px; background:var(--bg); color:var(--text-soft);
+  display:flex; align-items:center; justify-content:center; font-size:15px;
+}
+.kpi-icon.danger{ background:var(--danger-soft); color:var(--danger); }
+.kpi-icon svg.icon{ width:1em; height:1em; }
+.kpi-value{ font-size:26px; font-weight:800; letter-spacing:-.5px; line-height:1.1; }
+.kpi-value small{ margin-left:5px; font-size:12px; font-weight:600; letter-spacing:0; color:var(--text-faint); }
+.kpi-meta{ display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
+.kpi-foot{ font-size:11.5px; color:var(--text-soft); }
+.delta{
+  font-family:'JetBrains Mono',monospace; font-size:11px; font-weight:600; white-space:nowrap;
+  padding:2px 8px; border-radius:999px; background:var(--bg); color:var(--text-soft);
+}
+.delta.up{ background:var(--success-soft); color:var(--success); }
+.delta.down{ background:var(--danger-soft); color:var(--danger); }
+
+.dash-row{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; }
+@media (max-width:1000px){ .dash-row{ grid-template-columns:1fr; } }
+.chart-box{ position:relative; width:100%; }
+
+.stock-bar{ height:6px; min-width:90px; border-radius:999px; background:var(--border-soft); overflow:hidden; }
+.stock-bar > span{ display:block; height:100%; border-radius:999px; background:var(--red); }
+.dash-note{ margin:12px 0 0; font-size:12px; color:var(--text-soft); }
