diff --git a/public/css/theme.css b/public/css/theme.css
index ee08349..80aaee5 100644
--- a/public/css/theme.css
+++ b/public/css/theme.css
@@ -546,7 +546,7 @@ button svg.icon:only-child{ margin-right:0; }
    ============================================================ */
 .dash-head{ display:flex; align-items:flex-end; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-bottom:18px; }
 .dash-head h1{ margin:0; font-size:22px; font-weight:800; letter-spacing:-.4px; }
-.dash-sub{ margin-top:3px; font-size:12px; color:var(--text-soft); text-transform:capitalize; }
+.dash-sub{ margin-top:3px; font-size:12px; color:var(--text-soft); }
 .dash-controls{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
 .dash-controls input[type=month]{ padding:6px 10px; }
 .dash-loading{ opacity:.55; pointer-events:none; transition:opacity .15s; }
@@ -582,3 +582,31 @@ button svg.icon:only-child{ margin-right:0; }
 .stock-bar{ height:6px; min-width:90px; border-radius:999px; background:var(--border-soft); overflow:hidden; }
 .stock-bar > span{ display:block; height:100%; border-radius:999px; background:var(--red); }
 .dash-note{ margin:12px 0 0; font-size:12px; color:var(--text-soft); }
+
+/* --- Dashboard: quick actions, toggles, status chips --- */
+.dash-quick{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin:0 0 18px; }
+.dash-quick-label{ font-size:10px; font-weight:700; letter-spacing:.8px; text-transform:uppercase; color:var(--text-faint); margin-right:2px; }
+.qbtn{
+  display:inline-flex; align-items:center; gap:7px; padding:8px 14px; border-radius:10px;
+  border:1px solid var(--border); background:var(--card); color:var(--text); text-decoration:none;
+  font-size:12.5px; font-weight:600; box-shadow:var(--shadow); cursor:pointer; transition:border-color .12s, transform .12s;
+}
+.qbtn:hover{ border-color:var(--red); transform:translateY(-1px); }
+.qbtn svg.icon{ width:15px; height:15px; }
+.qbtn.primary{ background:var(--red); border-color:var(--red); color:#fff; }
+.qbtn.primary:hover{ filter:brightness(1.06); }
+.qbtn.small{ padding:5px 10px; font-size:11.5px; box-shadow:none; }
+
+.panel-tools{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
+.seg{ display:inline-flex; padding:2px; border-radius:9px; background:var(--bg); border:1px solid var(--border-soft); }
+.seg button{
+  border:0; background:transparent; color:var(--text-soft); font:inherit; font-size:11.5px; font-weight:600;
+  padding:4px 10px; border-radius:7px; cursor:pointer;
+}
+.seg button.active{ background:var(--card); color:var(--text); box-shadow:0 1px 2px rgba(0,0,0,.08); }
+
+.level{ display:flex; align-items:center; gap:10px; }
+.level .stock-bar{ width:110px; flex:none; min-width:0; }
+.chip{ font-size:10.5px; font-weight:700; padding:2px 8px; border-radius:999px; white-space:nowrap; }
+.chip.danger{ background:var(--danger-soft); color:var(--danger); }
+.chip.warn{ background:#fdf3e1; color:#a8731a; }
